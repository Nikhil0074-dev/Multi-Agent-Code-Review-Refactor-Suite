# Copy to .env and export, or set as GitHub Actions secrets / variables. Never commit real keys.

# Backend: hosted (any OpenAI-compatible API), local (Ollama) or mock (offline, no model)
LLM_BACKEND=hosted
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://localhost:11434

# Review behaviour
REVIEW_MODE=debate            # single | independent | debate
MIN_CONFIDENCE=0.5
MAX_CHALLENGED=15
MAX_REPORT_FINDINGS=30
MAX_DIFF_CHARS=60000
MAX_WORKERS=3
REVIEW_CONVENTIONS=           # short text: your team's rules

# Publishing
ENABLE_INLINE_COMMENTS=false
ALLOW_FORK_REVIEW=false

# Optional patch suggestions (needs the repo checked out; never auto-applied)
ENABLE_PATCHES=false
PATCH_TEST_COMMAND=           # e.g. pytest -q
