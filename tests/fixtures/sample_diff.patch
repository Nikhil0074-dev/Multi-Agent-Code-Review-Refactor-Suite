+def totals(conn, users):
+    result = {}
+    for user in users:
+        cur = conn.cursor()
+        cur.execute("SELECT SUM(amount) FROM orders WHERE user_id = ?", (user.id,))
+        result[user.id] = cur.fetchone()[0] or 0
+    return result
